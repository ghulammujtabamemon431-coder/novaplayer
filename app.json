{
  "expo": {
    "name": "Nova Player",
    "slug": "nova-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.novamax.player",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "web": {},
    "plugins": [
      "expo-av",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ]
  }
}
